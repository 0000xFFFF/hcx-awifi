<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Scan Button -->
    <Button
        android:id="@+id/scanButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Scan"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@+id/loadCsvButton"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Load CSV Button -->
    <Button
        android:id="@+id/loadCsvButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Load CSV"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/scanButton"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Status Label under Scan -->
    <TextView
        android:id="@+id/scanStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Status: Idle"
        android:textColor="#BB86FC"
        app:layout_constraintEnd_toEndOf="@id/scanButton"
        app:layout_constraintStart_toStartOf="@id/scanButton"
        app:layout_constraintTop_toBottomOf="@id/scanButton" />

    <!-- CSV Loaded Label under Load CSV -->
    <TextView
        android:id="@+id/loadCsvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="CSV Loaded: 0 items"
        android:textColor="#BB86FC"
        app:layout_constraintEnd_toEndOf="@id/loadCsvButton"
        app:layout_constraintStart_toStartOf="@id/loadCsvButton"
        app:layout_constraintTop_toBottomOf="@id/loadCsvButton" />

    <!-- ListView -->
    <ListView
        android:id="@+id/networkList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#121212"
        android:divider="#1F1F1F"
        android:dividerHeight="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanStatusLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
