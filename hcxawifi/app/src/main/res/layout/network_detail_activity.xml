<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/monokai_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- SSID at the top -->
        <TextView
            android:id="@+id/ssidText"
            android:text="SSID"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="@color/monokai_foreground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- Signal strength -->
        <ProgressBar
            android:id="@+id/signalBarDetail"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/monokai_green"
            android:layout_marginBottom="24dp"/>

        <!-- Details table -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shrinkColumns="1"
            android:stretchColumns="1">

            <!-- BSSID row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="BSSID:"
                    android:textColor="@color/monokai_purple"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/bssidText"
                    android:text="..."
                    android:textColor="@color/monokai_purple"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

            <!-- Frequency row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="Frequency:"
                    android:textColor="@color/monokai_yellow"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/frequencyText"
                    android:text="..."
                    android:textColor="@color/monokai_yellow"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

            <!-- Channel row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="Channel:"
                    android:textColor="@color/monokai_orange"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/channelText"
                    android:text="..."
                    android:textColor="@color/monokai_orange"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

            <!-- Capabilities row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="Capabilities:"
                    android:textColor="@color/monokai_pink"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/capabilitiesText"
                    android:text="..."
                    android:textColor="@color/monokai_pink"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

            <!-- Level row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="Level:"
                    android:textColor="@color/monokai_green"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/levelText"
                    android:text="..."
                    android:textColor="@color/monokai_green"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

            <!-- Level row -->
            <TableRow android:layout_marginBottom="12dp">
                <TextView
                    android:text="Password:"
                    android:textColor="@color/monokai_red"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/passwordText"
                    android:text="..."
                    android:textColor="@color/monokai_red"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </TableRow>

        </TableLayout>

    </LinearLayout>
</ScrollView>